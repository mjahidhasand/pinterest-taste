# Copy to .env (gitignored) and fill in.

# Claude subscription token for the analyst: run `claude setup-token` yourself and paste it here.
# Do NOT set ANTHROPIC_API_KEY. It would take priority and bill the API instead.
CLAUDE_CODE_OAUTH_TOKEN=

# Absolute path on the VM to the repo's write deploy key (kept outside the repo).
DEPLOY_KEY_PATH=/home/adv-devpc-002/.pinterest-taste/deploy_key

# Optional password for the noVNC login screen (it's only reachable through an SSH tunnel either way).
VNC_PASSWORD=

# Pacing: random gap between searches in minutes, and a daily cap.
MIN_GAP_MIN=15
MAX_GAP_MIN=40
MAX_SEARCHES_PER_DAY=60

# Analyst: model alias and how many new pins a category needs before a run.
ANALYST_MODEL=sonnet
ANALYST_MIN_NEW=40
